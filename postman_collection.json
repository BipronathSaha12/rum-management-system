{
  "info": {
    "_postman_id": "rum-hospital-api-collection-v21",
    "name": "RUM Hospital Appointment Management System API",
    "description": "Production-ready Postman collection for RUM Hospital REST API. Covers JWT authentication, profile management, doctor CRUD, appointment workflows, automatic billing, and dashboard analytics.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "reset_uid",
      "value": "",
      "type": "string"
    },
    {
      "key": "reset_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication APIs",
      "item": [
        {
          "name": "1.1 Patient Registration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Michael Scott\",\n  \"email\": \"michael.scott@example.com\",\n  \"phone_number\": \"+8801733333333\",\n  \"address\": \"Scranton Dunder Mifflin\",\n  \"password\": \"PatientPass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/register/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "register",
                ""
              ]
            }
          }
        },
        {
          "name": "1.2 Login (Admin / Doctor / Patient)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access) {",
                  "    pm.collectionVariables.set('access_token', jsonData.access);",
                  "    pm.collectionVariables.set('refresh_token', jsonData.refresh);",
                  "    console.log('JWT Tokens updated successfully');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@rumhospital.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/login/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "login",
                ""
              ]
            }
          }
        },
        {
          "name": "1.3 Token Refresh",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/token/refresh/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "token",
                "refresh",
                ""
              ]
            }
          }
        },
        {
          "name": "1.4 Forgot Password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var data = pm.response.json();",
                  "if (data.uid && data.token) {",
                  "    pm.collectionVariables.set('reset_uid', data.uid);",
                  "    pm.collectionVariables.set('reset_token', data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patient.john@gmail.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/forgot-password/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "forgot-password",
                ""
              ]
            }
          }
        },
        {
          "name": "1.5 Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"uid\": \"{{reset_uid}}\",\n  \"token\": \"{{reset_token}}\",\n  \"new_password\": \"NewPassword123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/reset-password/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "reset-password",
                ""
              ]
            }
          }
        }
      ]
