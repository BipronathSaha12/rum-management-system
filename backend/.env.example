# RUM Hospital Management System - Environment Variables Template
# Copy this file to .env and configure your production credentials.

DEBUG=False
SECRET_KEY=replace-with-a-cryptographically-secure-random-50-character-key-for-production
ALLOWED_HOSTS=rumhospital.com,api.rumhospital.com,127.0.0.1,localhost

# Database Configuration (Defaults to SQLite if omitted; PostgreSQL for high-scale production)
# Example PostgreSQL URL with pgBouncer / Connection Pooling:
# DATABASE_URL=postgres://rum_admin:SecureProdPassword2026!@postgres-cluster.internal:5432/rum_hospital_db
DATABASE_URL=sqlite:///db.sqlite3

# SSLCommerz Payment Gateway Configuration (Sandbox / Production)
SSLCOMMERZ_STORE_ID=rumhospital_sandbox_001
SSLCOMMERZ_STORE_PASS=rumhospital_secret_key_sandbox
SSLCOMMERZ_IS_SANDBOX=True

# bKash Payment Gateway Configuration
BKASH_APP_KEY=bkash_app_key_placeholder
BKASH_APP_SECRET=bkash_app_secret_placeholder
BKASH_USERNAME=bkash_merchant_user
BKASH_PASSWORD=bkash_merchant_password
BKASH_IS_SANDBOX=True

# Email & Notification Settings (SMTP for Password Reset & Booking Confirmations)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=notifications@rumhospital.com
EMAIL_HOST_PASSWORD=your_app_password
